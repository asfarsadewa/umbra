{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umbra",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    // No client-side routing, so a missing hashed asset must 404 rather than
    // fall through to index.html as text/html (which breaks module loading
    // during the brief window right after a deploy).
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "umbra.asfarlab.fun",
      "custom_domain": true
    }
  ]
}
